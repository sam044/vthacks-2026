# Proposed HokieCare configuration only. Application code does not exist yet.
# Copy to .env locally; never commit real values.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:8000
# Local development uses the user-selected OAuth profile.
# Do not set CONFIG_PROFILE on the hosted deployment; use OAuth M2M there.
DATABRICKS_CONFIG_PROFILE=sam
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=hokiecare
DATABRICKS_SERVING_ENDPOINT=
DATABRICKS_GENIE_SPACE_ID=
MLFLOW_EXPERIMENT_ID=
# For deployment: dedicated, scoped OAuth service principal.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Optional tracks, disabled until the core application works.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GODADDY_API_KEY=
GODADDY_API_SECRET=
ANS_AGENT_HOST=
