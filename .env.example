# Template only: export variables in your shell. No automatic .env loading.
# Local development uses the user-selected OAuth profile, with CLI on PATH.
DATABRICKS_CONFIG_PROFILE=sam
DATABRICKS_WAREHOUSE_ID=3d3974209bf81d4b
DATABRICKS_CHAT_ENDPOINT=databricks-qwen3-next-80b-a3b-instruct
# Local HTTP only; production defaults to secure cookies. Set false in your local shell.
# HOKIECARE_COOKIE_SECURE=false
# HOKIECARE_BOOKING_DB=runtime/appointments.sqlite3
# Railway: omit CONFIG_PROFILE and use the dedicated service-principal OAuth.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_AUTH_TYPE=oauth-m2m
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# PORT=8000
# HOKIECARE_STATIC_DIR=/app/static
# Booking storage: defaults to SQLite until the verified operator cutover.
# HOKIECARE_BOOKING_STORE=lakebase
# LAKEBASE_ENDPOINT=projects/hokiecare-booking/branches/production/endpoints/primary
# PGHOST=<verified Lakebase endpoint host>
# PGDATABASE=databricks_postgres
# PGUSER=<hosted service principal application ID>

# Optional MOCK appointment confirmations + reminders. Disabled until configured.
# Export the same settings in the web process and the email worker.
# HOKIECARE_EMAIL_ENABLED=true
# HOKIECARE_PUBLIC_ORIGIN=https://your-app.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=HokieCare Demo <verified-sender@your-domain.example>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Implicit TLS uses SMTP_SECURITY=tls and SMTP_PORT=465.
